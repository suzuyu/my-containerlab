+// SPDX-License-Identifier: Apache-2.0
+// Copyright Authors of Cilium
+
+package check
+
+import (
+	"fmt"
+	"net"
+
+	flow "github.com/cilium/cilium/api/v1/flow"
+	"github.com/cilium/cilium/cilium-cli/connectivity/filters"
+	"github.com/cilium/cilium/cilium-cli/utils/features"
+)
+
+// SelfServiceSocketRequirements is limited to the lab self-Service scenario.
+// PRE proves a socket lookup of the Service, not translation completion or a
+// TCP handshake. ExecInPod must separately validate the curl result.
+func SelfServiceSocketRequirements(pod Pod, svc Service, peers map[string]Pod, family features.IPFamily) ([]filters.FlowSetRequirement, error) {
+	src, dst := pod.Address(family), svc.Address(family)
+	if pod.NameWithoutNamespace() == "" || svc.NameWithoutNamespace() == "" ||
+		net.ParseIP(src) == nil || net.ParseIP(dst) == nil || svc.Port() == 0 ||
+		pod.Namespace() != svc.Service.Namespace || len(svc.Service.Spec.Selector) == 0 {
+		return nil, fmt.Errorf("requires a named Pod and literal-IP Service in the same namespace")
+	}
+	count := 0
+	for _, peer := range peers {
+		if peer.Namespace() != svc.Service.Namespace {
+			continue
+		}
+		matches := true
+		for key, value := range svc.Service.Spec.Selector {
+			if peer.Pod.Labels[key] != value {
+				matches = false
+				break
+			}
+		}
+		if matches {
+			if peer.Name() != pod.Name() || peer.Address(family) != src {
+				return nil, fmt.Errorf("Service selects another test Pod: %s", peer.Name())
+			}
+			count++
+		}
+	}
+	if count != 1 {
+		return nil, fmt.Errorf("expected exactly one matching test Pod, got %d", count)
+	}
+	f := &selfSocketFilter{src: src, dst: dst, ns: pod.Namespace(), pod: pod.NameWithoutNamespace(), service: svc.NameWithoutNamespace(), port: svc.Port()}
+	req := filters.FlowRequirement{Filter: f, Msg: "self-Service PRE socket lookup (HTTP result checked by curl)"}
+	// A single observation is sufficient. It is deliberately not labelled SYN/FIN.
+	return []filters.FlowSetRequirement{{First: req, Last: req, RejectExceptions: true,
+		Except: []filters.FlowRequirement{{Filter: &selfSocketFailure{src: src, dst: dst, port: svc.Port()}, Msg: "self-Service drop or RST"}},
+	}}, nil
+}
+
+type selfSocketFilter struct {
+	src, dst, ns, pod, service string
+	port                       uint32
+}
+
+func (s *selfSocketFilter) String(*filters.FlowContext) string {
+	return fmt.Sprintf("socket(%s/%s %s -> %s/%s %s:%d PRE)", s.ns, s.pod, s.src, s.ns, s.service, s.dst, s.port)
+}
+func (s *selfSocketFilter) Match(f *flow.Flow, _ *filters.FlowContext) bool {
+	ip, tcp, source, service := f.GetIP(), f.GetL4().GetTCP(), f.GetSource(), f.GetDestinationService()
+	expectedFamily := flow.IPVersion_IPv6
+	if net.ParseIP(s.src).To4() != nil {
+		expectedFamily = flow.IPVersion_IPv4
+	}
+	return f.GetType() == flow.FlowType_SOCK && f.GetVerdict() == flow.Verdict_TRACED &&
+		f.GetSockXlatePoint() == flow.SocketTranslationPoint_SOCK_XLATE_POINT_PRE_DIRECTION_FWD &&
+		f.GetSocketCookie() != 0 && f.GetCgroupId() != 0 &&
+		ip.GetSource() == s.src && ip.GetDestination() == s.dst && ip.GetIpVersion() == expectedFamily &&
+		tcp != nil && tcp.GetDestinationPort() == s.port &&
+		source.GetNamespace() == s.ns && source.GetPodName() == s.pod &&
+		service.GetNamespace() == s.ns && service.GetName() == s.service
+}
+
+// PRE has no ephemeral source port. Reject any observed failure for this exact
+// Pod/VIP or Pod/self-IP port tuple within the action window, conservatively.
+type selfSocketFailure struct {
+	src, dst string
+	port     uint32
+}
+
+func (s *selfSocketFailure) String(*filters.FlowContext) string {
+	return "scoped self-Service drop/RST"
+}
+func (s *selfSocketFailure) Match(f *flow.Flow, _ *filters.FlowContext) bool {
+	ip, tcp := f.GetIP(), f.GetL4().GetTCP()
+	if ip == nil || tcp == nil {
+		return false
+	}
+	forward := ip.Source == s.src && (ip.Destination == s.dst || ip.Destination == s.src) && tcp.DestinationPort == s.port
+	reverse := ip.Destination == s.src && (ip.Source == s.dst || ip.Source == s.src) && tcp.SourcePort == s.port
+	return (forward || reverse) && (f.GetVerdict() == flow.Verdict_DROPPED || f.GetDropReasonDesc() != flow.DropReason_DROP_REASON_UNKNOWN || tcp.GetFlags().GetRST())
+}
