+func tcpFlow(src, dst string, flags *flow.TCPFlags, drop bool) *observer.GetFlowsResponse_Flow {
+	f := &flow.Flow{IP: &flow.IP{Source: src, Destination: dst}, L4: &flow.Layer4{Protocol: &flow.Layer4_TCP{TCP: &flow.TCP{SourcePort: 43000, DestinationPort: 8080, Flags: flags}}}, Verdict: flow.Verdict_FORWARDED}
+	if flags.ACK && flags.SYN {
+		f.IP.Source = dst
+		f.IP.Destination = src
+		f.L4.GetTCP().SourcePort = 8080
+		f.L4.GetTCP().DestinationPort = 43000
+	}
+	if drop {
+		f.Verdict = flow.Verdict_DROPPED
+		f.DropReasonDesc = flow.DropReason_POLICY_DENIED
+	}
+	return &observer.GetFlowsResponse_Flow{Flow: f}
+}
+func TestLabServiceMatcherRejectsIncorrectTraffic(t *testing.T) {
+	svc := fixtureService()
+	client := fixturePod("lab", "client", "10.0.0.1", "fd00::1")
+	backend := fixturePod("lab", "echo", "10.0.0.2", "fd00::2")
+	for _, family := range []features.IPFamily{features.IPFamilyV4, features.IPFamilyV6} {
+		p := ServiceFlowParameters(svc, map[string]Pod{"echo": backend}, family)
+		for _, tc := range []struct {
+			name, src, dst   string
+			drop, deny, want bool
+		}{
+			{"backend-success", client.Address(family), backend.Address(family), false, false, true},
+			{"vip-success", client.Address(family), svc.Address(family), false, false, true},
+			{"unrelated-destination", client.Address(family), "10.99.99.99", false, false, false},
