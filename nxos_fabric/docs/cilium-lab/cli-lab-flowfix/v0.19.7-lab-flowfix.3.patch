+			{"packet-not-socket", func(f *flow.Flow) { f.Type = flow.FlowType_L3_L4; f.L4.GetTCP().Flags = &flow.TCPFlags{SYN: true} }, false},
+			{"dropped-socket", func(f *flow.Flow) { f.Verdict = flow.Verdict_DROPPED }, false},
