+		want := pods["valid"].Address(family)
+		if p.DNSRequired || len(p.AltDstIPs) != 1 || p.AltDstIPs[0] != want {
+			t.Fatalf("unexpected parameters: %+v", p)
+		}
+	}
+	svc.Service.Spec.Selector = nil
+	if p := ServiceFlowParameters(svc, pods, features.IPFamilyV4); len(p.AltDstIPs) != 0 {
+		t.Fatal("empty selector accepted backends")
+	}
+	svc.Service.Spec.ClusterIP = core.ClusterIPNone
+	if !ServiceFlowParameters(svc, pods, features.IPFamilyV4).DNSRequired {
+		t.Fatal("headless name lost DNS requirement")
+	}
