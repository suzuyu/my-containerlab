+// SPDX-License-Identifier: Apache-2.0
+// Lab candidate: preserve concrete Service/backend destinations after Socket LB.
+package check
+
+import (
+	"github.com/cilium/cilium/cilium-cli/utils/features"
+	"net"
+	"slices"
+)
+
+// ServiceFlowParameters accepts the Service VIP and only matching echo backends.
+// This lab helper covers selector-based echo Services with unchanged target ports.
+func ServiceFlowParameters(svc Service, pods map[string]Pod, family features.IPFamily) FlowParameters {
+	p := FlowParameters{DNSRequired: net.ParseIP(svc.Address(family)) == nil, AltDstPort: svc.Port()}
+	if len(svc.Service.Spec.Selector) == 0 {
+		return p
+	}
+	for _, pod := range pods {
+		if pod.Pod.Namespace != svc.Service.Namespace {
+			continue
+		}
+		matches := true
+		for k, v := range svc.Service.Spec.Selector {
+			if got, ok := pod.Pod.Labels[k]; !ok || got != v {
+				matches = false
+				break
+			}
+		}
+		if !matches {
+			continue
+		}
+		ip := pod.Address(family)
+		if ip != "" && !slices.Contains(p.AltDstIPs, ip) {
+			p.AltDstIPs = append(p.AltDstIPs, ip)
+		}
+	}
+	slices.Sort(p.AltDstIPs)
+	return p
+}
